#!/bin/sh
# (The udev half irvingpop wrote for the no-autosuspend rule is gone with the
# rule: USB autosuspend is left at libfprint's default for the sensor.)
set -e

case "$1" in
    configure)
        # The fprintd.service.d drop-in this package installs is read by
        # systemd only after a daemon-reload; without one the resume gate is
        # inert until the next boot (the bug v0.4.5 shipped with in the Fedora
        # package, fixed in 8330296). dh_installsystemd does not cover it: a
        # drop-in is not a unit file.
        if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
