#!/usr/bin/make -f

# The two integration files (systemd-sleep hook, no-autosuspend udev rule)
# live at ../../integration in the repo tree, not under this source package,
# and are not part of the meson build. dh_auto_install (meson) installs the
# module itself into the TOD drivers directory reported by
# pkg-config --variable=tod_driversdir libfprint-2-tod-1 (meson.build resolves
# this at configure time), so only the two integration files need adding here.

%:
	dh $@ --buildsystem=meson

override_dh_auto_install:
	dh_auto_install
	install -Dm0755 ../../integration/50-egis0576-fp-resume.sh \
		debian/libfprint-2-tod1-egis0576/usr/lib/systemd/system-sleep/50-egis0576-fp-resume.sh
	install -Dm0644 ../../integration/60-egis0576-fp-nosuspend.rules \
		debian/libfprint-2-tod1-egis0576/etc/udev/rules.d/60-egis0576-fp-nosuspend.rules
