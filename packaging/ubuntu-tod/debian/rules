#!/usr/bin/make -f

# The three integration files (systemd-sleep hook, fprintd resume-wait gate
# and its fprintd.service.d drop-in) are read from
# extra-integration/, a symlink to ../../integration checked into this
# source directory (see meson.build for why this is a symlink and not a
# copy) and are not part of the meson build. dh_auto_install (meson) installs
# the module itself into the TOD drivers directory reported by pkg-config
# --variable=tod_driversdir libfprint-2-tod-1 (meson.build resolves this at
# configure time), so only the three integration files need adding here.
# Mirrors packaging/fedora/libfprint.spec's %install and
# packaging/debian/rules' override_dh_auto_install.
#
# No udev rule: USB autosuspend stays at libfprint's default for the sensor
# (ID_AUTOSUSPEND=1 in the hwdb), validated with the driver.

%:
	dh $@ --buildsystem=meson

override_dh_auto_install:
	dh_auto_install
	install -Dm0755 extra-integration/50-egis0576-fp-resume.sh \
		debian/libfprint-2-tod1-egis0576/usr/lib/systemd/system-sleep/50-egis0576-fp-resume.sh
	install -Dm0755 extra-integration/egis0576-fp-wait \
		debian/libfprint-2-tod1-egis0576/usr/libexec/egis0576-fp-wait
	install -Dm0644 extra-integration/egis0576-fprintd-wait.conf \
		debian/libfprint-2-tod1-egis0576/usr/lib/systemd/system/fprintd.service.d/10-egis0576-resume-wait.conf
