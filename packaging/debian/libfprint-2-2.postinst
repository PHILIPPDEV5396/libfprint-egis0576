#!/bin/sh
# The fprintd.service.d drop-in this package installs only takes effect after
# the running system is told about it: systemd reads drop-ins for
# fprintd.service after a daemon-reload. Without one the resume gate is inert
# until the next boot -- exactly the bug v0.4.5 shipped with in the Fedora
# package (fixed in 8330296). dh_installsystemd does not cover it: the drop-in
# is not a unit file, so it is not part of the unit set debhelper generates
# snippets for. Mirrors packaging/fedora/libfprint.spec's %post and
# packaging/ubuntu-tod/debian/libfprint-2-tod1-egis0576.postinst; keep the
# three in step. (Earlier versions also reloaded udev for a no-autosuspend
# rule; that rule is gone, USB autosuspend is left at libfprint's default.)
set -e

case "$1" in
    configure)
        if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
