# EgisTec EH576 (1c7a:0576): disable USB autosuspend for the fingerprint sensor.
#
# The driver holds no session state — the EGIS/SIGE protocol is stateless — so this
# is a conservative default rather than a fix for a measured failure: an
# interactively used reader should not have to come back from runtime PM on every
# press. (Measured separately: USB autosuspend does NOT reset the sensor's protocol
# mode, so this rule was never what caused the dual-boot problem.)
#
# Install to /etc/udev/rules.d/ then:
#   sudo udevadm control --reload-rules && sudo udevadm trigger --attr-match=idVendor=1c7a
# Delete the file (and reload) to revert. install.sh does this for you.
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="1c7a", ATTR{idProduct}=="0576", TEST=="power/control", ATTR{power/control}="on"
