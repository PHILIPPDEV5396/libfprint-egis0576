diff --git a/libfprint/meson.build b/libfprint/meson.build
index f11533c..fe3f692 100644
--- a/libfprint/meson.build
+++ b/libfprint/meson.build
@@ -116,6 +116,12 @@ driver_sources = {
     ),
     'etes603' : files('drivers/etes603.c'),
     'egis0570' : files('drivers/egis0570.c'),
+    'egis0576' : files(
+        'drivers/egis0576.c',
+        # the sensor's plaintext EGIS/SIGE protocol over gusb (what its own
+        # vendor driver speaks); plain C, built under the normal driver flags
+        'drivers/egis0576/egis0576_proto.c',
+    ),
     'egismoc' : files('drivers/egismoc/egismoc.c'),
     'egis_etu905' : files('drivers/egismoc/egis_etu905.c'),
     'vfs0050' : files('drivers/vfs0050.c'),
@@ -250,13 +256,59 @@ libfprint_private = static_library('fprint-private',
     link_with: libnbis,
     install: false)
 
+# The egis0576 driver's matcher is Egis' own extractor+matcher, reimplemented
+# as native flat-memory C (reverse-engineered from the Windows driver). That
+# translated code intentionally mixes int/pointer types and relies on exact
+# stack layout, so it is built as a separate static library with relaxed flags
+# instead of libfprint's strict -Werror driver build.
+egis0576_engine_libs = []
+if 'egis0576' in drivers
+    # Host matcher flavour (meson option 'egis0576_matcher', default 'vendor').
+    # 'cleanroom' swaps the vendor extractor/matcher for Thaddeus Stepanovich's
+    # LGPL correlation matcher; documented in drivers/egis0576/egis_engine_cleanroom.c.
+    # Exactly one of the two libraries is built. The USB protocol itself
+    # (egis0576_proto.c) lives in the driver sources above, under the normal
+    # driver flags -- only the translated vendor code needs the relaxed ones.
+    egis0576_matcher = get_option('egis0576_matcher')
+    if egis0576_matcher == 'vendor'
+        egis0576_engine_libs = [ static_library('egis0576-engine',
+            sources: [
+                'drivers/egis0576/egis_funcs.c',
+                'drivers/egis0576/egis_rt.c',
+                'drivers/egis0576/egis_engine.c',
+                'drivers/egis0576/egis_preprocess.c',
+                'drivers/egis0576/egis_coherence_map.c',
+            ],
+            include_directories: include_directories('drivers/egis0576'),
+            dependencies: [ gusb_dep ],
+            c_args: [
+                '-w', '-fno-stack-protector', '-fpermissive', '-fwrapv',
+                '-Wno-int-conversion', '-Wno-incompatible-pointer-types',
+                '-Wno-implicit-function-declaration',
+            ],
+            install: false) ]
+    else
+        # Clean-room matcher + its egis_engine.h adapter: plain C99, built with
+        # libfprint's normal flags (no -w, no -fno-stack-protector).
+        egis0576_engine_libs = [ static_library('egis0576-cleanroom',
+            sources: [
+                'drivers/egis0576/egis_engine_cleanroom.c',
+                'drivers/egis0576/tsteppy/egis_match.c',
+            ],
+            include_directories: include_directories('drivers/egis0576',
+                                                     'drivers/egis0576/tsteppy'),
+            dependencies: [ mathlib_dep ],
+            install: false) ]
+    endif
 libfprint_drivers = static_library('fprint-drivers',
     sources: drivers_sources,
     c_args: drivers_cflags,
     dependencies: deps,
-    link_with: libfprint_private,
+    link_with: [libfprint_private] + egis0576_engine_libs,
     install: false)
 
+endif
+
 mapfile = files('libfprint.ver')[0]
 if meson.version().version_compare('>=1.4')
     mapfile_path = mapfile.full_path()
diff --git a/meson.build b/meson.build
index ab09dc1..a51abd5 100644
--- a/meson.build
+++ b/meson.build
@@ -132,6 +132,7 @@ drivers_info = {
     'egis0570': {},
     'egismoc': {},
     'egis_etu905': {},
+    'egis0576': {},
     'vcom5s': {},
     'synaptics': {},
     'elan': { 'endian_dependent': true },
diff --git a/meson_options.txt b/meson_options.txt
index 3c4cd26..1a992b2 100644
--- a/meson_options.txt
+++ b/meson_options.txt
@@ -34,3 +34,9 @@ option('installed-tests',
        description: 'Whether to install the installed tests',
        type: 'boolean',
        value: true)
+
+option('egis0576_matcher',
+       description: 'Which host matcher the egis0576 (EgisTec EH576) driver links: vendor = Egis extractor/matcher translated from the Windows driver (default, not upstreamable); cleanroom = Thaddeus Stepanovich\'s LGPL correlation matcher (egis_match.c). Templates enrolled under one flavour are rejected by the other (re-enrol after switching).',
+       type: 'combo',
+       choices: ['vendor', 'cleanroom'],
+       value: 'vendor')
