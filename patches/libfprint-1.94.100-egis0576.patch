diff --git a/libfprint/meson.build b/libfprint/meson.build
index f11533c..8e6389c 100644
--- a/libfprint/meson.build
+++ b/libfprint/meson.build
@@ -116,6 +116,12 @@ driver_sources = {
     ),
     'etes603' : files('drivers/etes603.c'),
     'egis0570' : files('drivers/egis0570.c'),
+    'egis0576' : files(
+        'drivers/egis0576.c',
+        # the sensor's plaintext EGIS/SIGE protocol over gusb (what its own
+        # vendor driver speaks); plain C, built under the normal driver flags
+        'drivers/egis0576/egis0576_proto.c',
+    ),
     'egismoc' : files('drivers/egismoc/egismoc.c'),
     'egis_etu905' : files('drivers/egismoc/egis_etu905.c'),
     'vfs0050' : files('drivers/vfs0050.c'),
@@ -250,11 +256,69 @@ libfprint_private = static_library('fprint-private',
     link_with: libnbis,
     install: false)
 
+# The egis0576 driver's matcher (meson option 'egis0576_matcher', default
+# 'gabor'): exactly one flavour is built into a static library the driver
+# links. 'gabor' and 'cleanroom' are LGPL clean-room C, documented in
+# drivers/egis0576/egis_engine_cleanroom.c; 'vendor' is Egis' own
+# extractor+matcher reimplemented as native flat-memory C from the Windows
+# driver, which intentionally mixes int/pointer types and relies on exact
+# stack layout, so it needs the relaxed flag set below instead of libfprint's
+# strict -Werror driver build. The USB protocol itself (egis0576_proto.c)
+# lives in the driver sources above, under the normal driver flags.
+egis0576_engine_libs = []
+if 'egis0576' in drivers
+    egis0576_matcher = get_option('egis0576_matcher')
+    if egis0576_matcher == 'vendor'
+        egis0576_engine_libs = [ static_library('egis0576-engine',
+            sources: [
+                'drivers/egis0576/egis_funcs.c',
+                'drivers/egis0576/egis_rt.c',
+                'drivers/egis0576/egis_engine.c',
+                'drivers/egis0576/egis_preprocess.c',
+                'drivers/egis0576/egis_coherence_map.c',
+            ],
+            include_directories: include_directories('drivers/egis0576'),
+            dependencies: [ gusb_dep ],
+            c_args: [
+                '-w', '-fno-stack-protector', '-fpermissive', '-fwrapv',
+                '-Wno-int-conversion', '-Wno-incompatible-pointer-types',
+                '-Wno-implicit-function-declaration',
+            ],
+            install: false) ]
+    elif egis0576_matcher == 'cleanroom'
+        # Clean-room matcher + its egis_engine.h adapter: plain C99, built with
+        # libfprint's normal flags (no -w, no -fno-stack-protector).
+        egis0576_engine_libs = [ static_library('egis0576-cleanroom',
+            sources: [
+                'drivers/egis0576/egis_engine_cleanroom.c',
+                'drivers/egis0576/tsteppy/egis_match.c',
+            ],
+            include_directories: include_directories('drivers/egis0576',
+                                                     'drivers/egis0576/tsteppy'),
+            c_args: [ '-DEGIS_CR_FRONTEND_TSTEPPY' ],
+            dependencies: [ mathlib_dep ],
+            install: false) ]
+    else
+        # The shipped matcher: the clean-room adapter on the Gabor front-end
+        # (drivers/egis0576/gabor/); plain C99 under the normal flags.
+        egis0576_engine_libs = [ static_library('egis0576-gabor',
+            sources: [
+                'drivers/egis0576/egis_engine_cleanroom.c',
+                'drivers/egis0576/gabor/egis_match_gabor.c',
+            ],
+            include_directories: include_directories('drivers/egis0576',
+                                                     'drivers/egis0576/tsteppy',
+                                                     'drivers/egis0576/gabor'),
+            dependencies: [ mathlib_dep ],
+            install: false) ]
+    endif
+endif
+
 libfprint_drivers = static_library('fprint-drivers',
     sources: drivers_sources,
     c_args: drivers_cflags,
     dependencies: deps,
-    link_with: libfprint_private,
+    link_with: [libfprint_private] + egis0576_engine_libs,
     install: false)
 
 mapfile = files('libfprint.ver')[0]
