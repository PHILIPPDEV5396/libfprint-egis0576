+++ b/meson_options.txt
@@ -34,3 +34,8 @@
        description: 'Whether to install the installed tests',
        type: 'boolean',
        value: true)
+option('egis0576_matcher',
+       description: 'Which host matcher the egis0576 (EgisTec EH576) driver links: vendor = Egis extractor/matcher translated from the Windows driver (default, not upstreamable); cleanroom = Thaddeus Stepanovich\'s LGPL correlation matcher (egis_match.c). Templates enrolled under one flavour are rejected by the other (re-enrol after switching).',
+       type: 'combo',
+       choices: ['vendor', 'cleanroom'],
+       value: 'vendor')
